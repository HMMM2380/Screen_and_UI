{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Cmake:Conf_debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset=Debug",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Cmake:Conf_release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset=Release",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Cmake:Build_debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset=Debug",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Cmake:Build_release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset=Release",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Cmake:Clean_debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug",
                "--target",
                "clean"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Cmake:Clean_release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Release",
                "--target",
                "clean"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CleanALL",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "build/*",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Make:Build",
            "type": "shell",
            "command": "bear",
            "args": [
                "--",
                "make",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Make:Clean",
            "type": "shell",
            "command": "make",
            "args": [
                "clean",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "ST:Flash",
            "type": "shell",
            "command": "st-flash",
            "args": [
                "--format=ihex",
                "write",
                "./build/Debug/${workspaceFolderBasename}.hex"
            ],
            "problemMatcher": []
        },
        {
            "label": "Openocd:Flash",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f","interface/stlink.cfg",
                "-f","target/stm32f1x.cfg",
                "-c", "set CPUTAPID 0x2ba01477",
                "-c","program build/Debug/${workspaceFolderBasename}.elf verify reset exit"
            ]
        },
        {
            "label": "OpenOCD_AT32:Flash",
            "type": "shell",
            "command": "/home/hmmm_fedora/Workspace/Code/MCU/ARM/AT32/OpenOCD_Linux_x86-64_V2.0.8/bin/openocd",
            "args": [
                "-s","/home/hmmm_fedora/Workspace/Code/MCU/ARM/AT32/OpenOCD_Linux_x86-64_V2.0.8/scripts",
                "-f","/home/hmmm_fedora/Workspace/Code/MCU/ARM/AT32/OpenOCD_Linux_x86-64_V2.0.8/scripts/interface/cmsis-dap.cfg",
                "-f","/home/hmmm_fedora/Workspace/Code/MCU/ARM/AT32/OpenOCD_Linux_x86-64_V2.0.8/scripts/target/at32f421xx.cfg",
                "-c","program build/Debug/${workspaceFolderBasename}.hex verify reset exit",
            ]
        },
    ]
}